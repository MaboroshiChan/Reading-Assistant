{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci --prefix reading-app-server && npm run build --prefix reading-app-server"
  },
  "deploy": {
    "startCommand": "npm run start --prefix reading-app-server",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
